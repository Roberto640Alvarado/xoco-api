# Database
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xocolatisimo?retryWrites=true&w=majority"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRATION="7d"

# Odoo — fuente de la información de negocio (ventas, productos, clientes, etc.)
# ODOO_BASE_URL: URL de tu instancia (ej. https://xocolatisimo.odoo.com)
# ODOO_DB: nombre de la base de datos de Odoo (una instancia puede alojar varias)
# El API key de Odoo NO vive aquí: SUPER_ADMIN la administra desde el panel y
# se guarda en una colección de Mongo (junto con su duración/expiración),
# para poder rotarla sin redeploy. Ver módulo Odoo/OdooConfig.
ODOO_BASE_URL="https://xocolatisimo.odoo.com"
ODOO_DB="xocolatisimo"
# uid del usuario de Odoo dueño del API key (lo pide execute_kw junto con la key)
ODOO_UID="7"

# Gmail SMTP (nodemailer) - pasos para configurarlo:
# 1. Activa la Verificación en 2 pasos en la cuenta de Google que va a
#    enviar los correos (Google Account → Security → 2-Step Verification).
# 2. Genera una Contraseña de aplicación: en esa misma sección de
#    seguridad, busca "App passwords", créala (ej. nómbrala "API Backend")
#    y Google te da un código de 16 caracteres — esa es SMTP_PASSWORD, NO
#    la contraseña normal de la cuenta.
# 3. Completa SMTP_USER con el correo de Gmail y SMTP_PASSWORD con esos 16
#    caracteres (sin espacios). SMTP_HOST/SMTP_PORT ya traen el valor
#    correcto para Gmail por defecto, no hace falta tocarlos.
# ⚠️ Nunca pongas la contraseña real en .env.example — solo en tu .env
# local (que ya está en .gitignore). ⚠️ Límite de Gmail: cuentas gratuitas
# permiten hasta 500 correos por día.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
MAIL_FROM="Xocolatísimo <your-email@gmail.com>"
MAIL_REPLY_TO="your-email@example.com"

# Password Reset
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Node
NODE_ENV="development"
PORT=4005
