// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  FINANZAS
  VENDEDOR
  // Planta (despacho): recibe las solicitudes de stock de las tiendas, dice
  // qué sí y qué no tiene, despacha y avisa que va en camino. Solo ve
  // Inventario → Solicitudes (ver MODULE_KEY_CEILING). Sin tienda asignada.
  PLANTA
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  password    String
  role        Role
  name        String?
  isActive    Boolean  @default(true)
  // Tienda asignada — SOLO para role=VENDEDOR (ver comentario en
  // scoped-pos-config-id.util.ts): un Vendedor únicamente ve datos de
  // esta tienda, el servidor lo fuerza sin importar lo que mande el
  // cliente. null para SUPER_ADMIN/FINANZAS.
  posConfigId Int?
  // Acceso individual a Inventario — SOLO aplica a role=VENDEDOR. Además de
  // que su tienda esté habilitada (StoreInventoryAccess), el Vendedor
  // necesita este permiso propio: así Super admin decide QUIÉN de cada
  // tienda entra (ej. un piloto con un solo usuario). Opcional porque los
  // documentos viejos de Mongo no traen el campo: null/ausente = sin acceso.
  inventoryEnabled Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

// Config de integración con Odoo, administrada por SUPER_ADMIN desde el
// panel (nunca por variables de entorno). `uid` es el id del usuario de
// Odoo dueño del API key — execute_kw lo pide siempre junto con la key
// (ver ejemplo de JSON-RPC que compartiste). `expiresAt` se calcula al
// crear/rotar la key como now() + durationDays.
//
// Cada rotación crea un documento nuevo y deja el anterior con isActive=false:
// así queda el historial de keys (Administración → Integración con Odoo).
model OdooConfig {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  apiKey       String
  uid          Int
  durationDays Int      @default(30)
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  // Quién registró esta key (null en las anteriores al historial o al seed).
  createdByEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("odoo_config")
}

// % de crecimiento mensual de visitas (órdenes) por tienda, sobre el
// total REAL del mes anterior (ver "Trafico de tiendas" / Dashboard
// Mercadeo.xlsx original). Un doc por tienda+año+mes — se sobreescribe
// (upsert) si el usuario vuelve a guardar el % de un mes que ya tenía
// uno. "Meta del mes" NUNCA se guarda aquí: se calcula al vuelo en
// GoalsService como totalRealMesAnterior * (1 + growthPercent), a partir
// de las órdenes reales de Odoo.
model StoreGoal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId    Int
  year           Int
  month          Int
  growthPercent  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@unique([posConfigId, year, month])
  @@map("store_goals")
}

// % de crecimiento mensual de VENTA ($) por tienda — mismo mecanismo que
// StoreGoal (arriba), pero para el módulo "Venta Mensual" (monto en
// dólares, no cantidad de órdenes). Es un % PROPIO e independiente del de
// StoreGoal: crecer en ventas ($) y crecer en visitas (órdenes) son metas
// distintas (ver plan-history de sales-goals). "Meta del mes" tampoco se
// guarda acá: se calcula al vuelo en SalesGoalsService, encadenada sobre
// la meta del mes anterior (mismo diseño que GoalsService.
// resolveTargetOrders, aplicado a totalRevenue).
model StoreSalesGoal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId    Int
  year           Int
  month          Int
  growthPercent  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@unique([posConfigId, year, month])
  @@map("store_sales_goals")
}

// % de crecimiento mensual de venta ($ facturado) por CLIENTE DE MAYOREO
// (Selectos, Operadora del Sur — ver src/sales/constants/wholesale-clients.const.ts).
// Mismo mecanismo que StoreSalesGoal, pero `clientKey` en vez de
// `posConfigId`: no son pos.config de Odoo, son cuentas de mayoreo fijas
// que se facturan sin pasar por caja (ver WholesaleClientTotalsService).
model WholesaleClientGoal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  clientKey      String
  year           Int
  month          Int
  growthPercent  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@unique([clientKey, year, month])
  @@map("wholesale_client_goals")
}

// % de crecimiento mensual del TICKET PROMEDIO (venta / cantidad de
// órdenes) por tienda — mismo mecanismo que StoreGoal/StoreSalesGoal
// (arriba), pero para esta tercera métrica. % PROPIO e independiente de
// los otros dos (ver plan-history de ticket-goals): igual que venta $ y
// visitas pueden crecer a ritmos distintos, el ticket promedio también es
// una meta de negocio separada (subir el ticket promedio sin más
// visitas, por ejemplo).
model StoreTicketGoal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId    Int
  year           Int
  month          Int
  growthPercent  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@unique([posConfigId, year, month])
  @@map("store_ticket_goals")
}

// Catálogo de módulos del dashboard cuyo acceso por rol es configurable
// desde el panel "Permisos" (Fase 3 de RBAC — ver
// src/common/constants/module-keys.const.ts para el catálogo de
// moduleKey y el techo original de @Roles() por módulo). Sin un
// documento para un (role, moduleKey) dado, el acceso se decide por
// default-allow — este modelo SOLO puede angostar el techo ya fijo de
// @Roles() en cada controlador, nunca ampliarlo (ver ModuleAccessGuard).
// Administración queda deliberadamente fuera de este catálogo por
// completo: no existe ningún moduleKey para /dashboard/admin/*, así
// SUPER_ADMIN nunca puede perder ese acceso desde este mismo panel.
model RoleModuleAccess {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  role           Role
  moduleKey      String
  enabled        Boolean
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@unique([role, moduleKey])
  @@map("role_module_access")
}

// Inventario por tienda — captura del conteo físico de cada producto,
// hecha por Finanzas de forma centralizada (ver plan-history de
// Inventario). Vive en NUESTRA base, no en Odoo: el API key de Odoo es
// de SOLO LECTURA, así que "cargar en Odoo como inventario inicial" (el
// paso del diagrama que dio el negocio) no se puede hacer desde esta app.
// Esta colección es entonces la fuente de verdad del inventario por
// tienda — no un espejo de Odoo — y por ahora solo guarda el valor
// ACTUAL (sin historial de versiones; ver InventoryRepository.upsert).
// `productId` es el id de product.product en Odoo: no hay FK real (Mongo
// + catálogo externo), se resuelve contra Odoo al leer (InventoryService
// cruza esta colección con GET product.product para traer nombre/unidad
// y mostrar en 0 los productos que aún no se han contado).
model StoreInventoryItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId    Int
  productId      Int
  quantity       Float
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  @@unique([posConfigId, productId])
  @@map("store_inventory_items")
}

// Segundo tramo de Inventario (ver plan-history): movimientos de salida
// que NO son venta — merma (producto dañado/vencido/perdido), regalía
// (obsequio a cliente), degustación (muestra gratis) y entrada (envío
// planta→tienda). Las ventas no pasan por aquí: esas ya se descuentan
// leyendo pos.order.line de Odoo directamente (ver
// InventoryService.findUnitsSoldSince) — esta colección es solo para lo
// que Odoo nunca sabría.
//
// ENTRADA es el único tipo que SUMA a estimatedQuantity en vez de restar
// (ver InventoryService.estimateQuantity) — los otros tres son salidas.
enum InventoryMovementType {
  MERMA
  REGALIA
  DEGUSTACION
  ENTRADA
}

// PENDIENTE solo cuando lo registra un VENDEDOR (necesita que Admin o
// Finanzas lo confirme antes de afectar estimatedQuantity, ver
// InventoryMovementsService.create). Cuando lo registra SUPER_ADMIN o
// FINANZAS queda CONFIRMADO de una vez — es la misma persona que hoy
// hace el conteo físico, no tiene sentido pedirle que se autoconfirme.
//
// ENTRADA ya NO tiene flujo de aprobación propio: el stock que llega de
// planta se pide, se despacha y se recibe con una solicitud
// (StoreStockRequest). Al confirmar la tienda la recepción, cada línea
// recibida crea una ENTRADA ya CONFIRMADA ligada a la solicitud
// (`stockRequestId`). EN_CAMINO y RECIBIDO quedan en el enum solo por las
// ENTRADA del flujo anterior (solicitud -> aceptar -> recibir -> confirmar),
// que ya no se pueden avanzar; los otros tipos nunca los usan.
enum InventoryMovementStatus {
  PENDIENTE
  EN_CAMINO
  RECIBIDO
  CONFIRMADO
  RECHAZADO
}

model StoreInventoryMovement {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId      Int
  productId        Int
  type             InventoryMovementType
  // Para MERMA/REGALIA/DEGUSTACION: lo que SALE. Para ENTRADA: lo
  // solicitado por el Vendedor (o lo registrado directo por
  // Admin/Finanzas, si no pasó por una solicitud). Siempre positivo.
  quantity         Float
  // Solo ENTRADA la usa: la cantidad real que el Vendedor confirmó
  // haber recibido (ver InventoryMovementsService.receive) — puede
  // diferir de `quantity` si no llegó completo. null hasta que se marca
  // RECIBIDO; estimateQuantity usa este valor sobre `quantity` en cuanto
  // existe (ver InventoryService.estimateQuantity).
  receivedQuantity Float?
  note             String?
  // Cuándo pasó de verdad (no cuándo se registró en el sistema) — lo que
  // usa InventoryService para decidir si cuenta "desde el último conteo"
  // de cada producto, igual que date_order en las ventas de Odoo.
  occurredAt       DateTime                @default(now())
  status           InventoryMovementStatus

  registeredByEmail String
  registeredByRole  Role
  createdAt         DateTime @default(now())

  // Solo se llenan al confirmar/rechazar un movimiento PENDIENTE (ver
  // InventoryMovementsService.resolve) — quedan null si lo registró
  // directamente Admin/Finanzas (ya nace CONFIRMADO).
  resolvedByEmail String?
  resolvedAt      DateTime?

  // Solo ENTRADA: cuándo y quién aceptó la solicitud (PENDIENTE ->
  // EN_CAMINO). Motivo obligatorio cuando algo pasa a RECHAZADO — lo ve
  // el Vendedor en su seguimiento.
  acceptedByEmail String?
  acceptedAt      DateTime?
  rejectionReason String?

  // Solo ENTRADA creada al recibir una solicitud de stock: de cuál vino
  // (para el detalle del Registro). null en mermas, regalías, degustaciones
  // y en las ENTRADA del flujo anterior.
  stockRequestId String? @db.ObjectId

  @@index([stockRequestId])
  @@map("store_inventory_movements")
}

// Qué tiendas ya tienen habilitado el módulo de Inventario para sus
// Vendedores. Mientras una tienda NO tenga fila con enabled=true, sus
// Vendedores no ven la sección ni pueden usar sus endpoints (403) — Admin y
// Finanzas sí la usan siempre, para cargar primero el stock manual de cada
// tienda. Solo SUPER_ADMIN lo cambia (Administración → Inventario).
model StoreInventoryAccess {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId    Int      @unique
  enabled        Boolean  @default(false)
  updatedByEmail String
  updatedAt      DateTime @updatedAt

  @@map("store_inventory_access")
}

// Historial de conteos físicos: StoreInventoryItem solo guarda el valor
// ACTUAL (se sobreescribe), así que cada vez que Finanzas guarda un
// conteo se agrega aquí una fila — alimenta el "Registro" de entradas y
// salidas por tienda (ver InventoryLedgerService). Solo existe desde que se
// creó este modelo: los conteos anteriores no tienen historial.
model StoreInventoryCountLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId      Int
  productId        Int
  quantity         Float
  // Lo que había guardado justo antes de este conteo — null si era el
  // primer conteo de ese producto en esa tienda.
  previousQuantity Float?
  countedAt        DateTime @default(now())
  countedByEmail   String

  @@index([posConfigId, countedAt])
  @@map("store_inventory_count_logs")
}

// ---------------------------------------------------------------------------
// Solicitudes de stock (tienda -> planta -> tienda)
//
// Reemplaza el flujo viejo de ENTRADA (un producto por solicitud, aceptado y
// confirmado por Admin/Finanzas). Ahora una solicitud es un PEDIDO con
// varios productos, como el "Formato envío a sucursales" que usa despacho:
//
//   SOLICITADA      la tienda lo envió; planta todavía no lo toma.
//   EN_PREPARACION  planta lo tomó y está respondiendo: qué sí, qué no y qué
//                   agrega (se puede guardar avance).
//   EN_CAMINO       planta despachó (completo o parcial); la tienda recibe un
//                   aviso para confirmar cuando llegue.
//   RECIBIDA        la tienda confirmó lo que llegó, línea por línea; recién
//                   ahí se suma al inventario de la tienda.
//   CANCELADA       la tienda (solo antes de que planta la tome) o Admin /
//                   Finanzas la cancelaron, con motivo.
//
// Cada paso queda en `events` (el seguimiento que ve Admin). El nombre y la
// categoría del producto se guardan en la línea (foto del momento): el PDF y
// el historial no dependen de que Odoo siga teniendo el mismo nombre.
// ---------------------------------------------------------------------------
enum StockRequestStatus {
  SOLICITADA
  EN_PREPARACION
  EN_CAMINO
  RECIBIDA
  CANCELADA
}

type StockRequestLine {
  productId         Int
  productName       String
  categoryName      String
  // "unidad" | "kg" — misma unidad que InventoryItemDoc.unit.
  unit              String
  // Lo que pidió la tienda. 0 en las líneas que agregó planta.
  requestedQuantity Float
  // Lo que planta envía. null mientras planta no responde esa línea; 0 =
  // "no hay".
  sentQuantity      Float?
  // Lo que la tienda confirma que llegó. null hasta confirmar la recepción.
  receivedQuantity  Float?
  // true = producto que planta agregó al pedido (la tienda no lo pidió).
  addedByPlant      Boolean @default(false)
  // Solo en líneas agregadas por planta: el producto PEDIDO al que
  // sustituye ("piden tiramisú, no hay, se manda brownie"). null = agregado
  // suelto, sin reemplazar nada.
  replacesProductId Int?
  plantNote         String?
  storeNote         String?
}

type StockRequestEvent {
  status  StockRequestStatus
  at      DateTime
  byEmail String
  byRole  Role
  note    String?
}

model StoreStockRequest {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  // Número corrido (SOL-0001), el "Número de Requisición" del formato.
  number         Int                 @unique
  posConfigId    Int
  status         StockRequestStatus
  // Nota general de la tienda al pedir.
  note           String?
  lines          StockRequestLine[]
  events         StockRequestEvent[]
  createdByEmail String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  // Cuándo salió de planta / cuándo la confirmó la tienda — para los tiempos
  // de entrega (Hora de envío / Hora de recepción del formato).
  dispatchedAt   DateTime?
  receivedAt     DateTime?

  @@index([posConfigId, createdAt])
  @@index([status])
  @@map("store_stock_requests")
}

// Contadores corridos (ej. el número de las solicitudes). `id` es el nombre
// del contador; `seq` el último número entregado.
model Counter {
  id  String @id @map("_id")
  seq Int

  @@map("counters")
}

// ---------------------------------------------------------------------------
// Recetas por tienda
//
// Productos que se venden en el POS pero no se guardan en bodega (ej. un
// Americano): cada venta descuenta sus ingredientes (ej. 1 cápsula
// Pacamara) en vez del producto vendido. Cada tienda tiene las suyas porque
// en cada una se preparan distinto. Solo SUPER_ADMIN las configura
// (Administración → Recetas). Una receta es de un solo nivel: un
// ingrediente no puede ser a su vez un producto con receta.
//
// Los nombres y la unidad se guardan como foto del momento (igual que en
// las solicitudes): el Kardex y el Registro no dependen de Odoo para
// decir "Americano ×2".
// ---------------------------------------------------------------------------
type RecipeComponent {
  productId   Int
  productName String
  // "unidad" | "kg"
  unit        String
  // Cuánto se gasta de este ingrediente por CADA unidad vendida.
  quantity    Float
}

model StoreRecipe {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  posConfigId    Int
  // Producto que se vende (el que sale en el ticket del POS).
  productId      Int
  productName    String
  components     RecipeComponent[]
  updatedByEmail String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([posConfigId, productId])
  @@index([posConfigId])
  @@map("store_recipes")
}

